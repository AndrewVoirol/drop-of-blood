    "preview": "vite preview --port 4179 --strictPort",
    "test": "vitest run"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.64",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
